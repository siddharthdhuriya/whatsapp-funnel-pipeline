# Vercel Project Settings > Environment Variables
# One project, so all of these live in the same settings panel.
# Never commit real values — this file is just a template.

# ---- Used by the frontend build (Vite only picks up VITE_ prefixed vars,
#      and these get embedded into the browser bundle — that's expected
#      and safe; the anon key is restricted by the RLS policies in
#      sql/schema.sql, not by secrecy) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Used only server-side, inside api/process-upload.js.
#      These are NEVER sent to the browser. ----

# Supabase project URL, e.g. https://abcxyz.supabase.co (same value as above)
SUPABASE_URL=

# Service role key (Dashboard > Project Settings > API > service_role)
# Keep SECRET — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Must match the Authorization header you
# configure on the Supabase Database Webhook.
PROCESS_WEBHOOK_SECRET=
